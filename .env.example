# Environment Variables
# Do not store real API keys here

# Optional: Path to custom models
# MODEL_DIR=results/models

# Optional: Server configuration
PORT=8000
HOST=127.0.0.1

# Models are provisioned explicitly; request handling never downloads by default.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# The local server uses one isolated worker and a 90-second inference deadline.
# Export these variables in your shell; the stdlib server does not load .env files.
