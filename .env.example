# Environment Variables
# Do not store real API keys here

# Optional: Path to custom models
# MODEL_DIR=results/models

# Optional: Server configuration
PORT=8000
HOST=127.0.0.1
ATS_DEPLOYMENT_MODE=local
# Private pilot: use a customer TLS/SSO gateway and Linux container.
# No bearer secret value belongs in this file or browser code.
# ATS_API_TOKEN_FILE=/run/secrets/ats_api_token
# ATS_ALLOWED_HOSTS=hr.example.com
# ATS_ALLOWED_ORIGINS=https://hr.example.com
# ATS_MODELS_DIR=/models
# ATS_CANDIDATE_MANIFEST_SHA256=<independently approved 64-character SHA-256>
# ATS_REQUESTS_PER_MINUTE=20
# ATS_WORKER_MEMORY_MIB=16384

# Models are provisioned explicitly; request handling never downloads by default.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# The local server uses one isolated worker and a 90-second inference deadline.
# Export these variables in your shell; the stdlib server does not load .env files.
